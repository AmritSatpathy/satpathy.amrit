# Required for the /places page. Copy to .env.local and fill in real values.

# Shared password that unlocks adding/ticking places (checked server-side).
PLACES_PASSWORD=

# S3 bucket that stores the list JSON, and its region.
PLACES_BUCKET=
PLACES_BUCKET_REGION=us-east-1

# AWS credentials the server uses to read/write the bucket.
# Can also be provided by an IAM role in the deploy environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
